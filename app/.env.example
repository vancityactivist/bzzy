# Postgres (Neon). Vercel fills this in when you add Neon from the Marketplace.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: https://<your-app>/api/auth/callback/github (production: https://bzzy.ca/...)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Production only, in Vercel: AUTH_URL=https://bzzy.ca. Leave unset locally and for
# previews, which use their own host.
# AUTH_URL=

# Production and Preview, in Vercel: lets previews sign in with GitHub through bzzy.ca
# (docs/domains.md). Needs a shared secret: AUTH_SECRET_1 in Production = AUTH_SECRET in
# Preview. Leave unset locally.
# AUTH_REDIRECT_PROXY_URL=https://bzzy.ca/api/auth

# Firmware updates (docs/ota.md). Only needed if FIRMWARE_REPO is private: a
# fine-grained token with Contents: Read on that repo.
# FIRMWARE_GITHUB_TOKEN=
# FIRMWARE_REPO=vancityactivist/bzzy

# Email via Resend (docs/email.md): team invites, join emails, the contact form.
# A send-only key for the bzzy.ca domain. Unset = no emails; invites still give a link.
# RESEND_API_KEY=
# MAIL_FROM="bzzy <noreply@bzzy.ca>"
# CONTACT_TO=hello@bzzy.ca
