# Postgres (Neon). Vercel fills this in when you add Neon from the Marketplace.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: https://<your-app>/api/auth/callback/github (production: https://bzzy.ca/...)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Production only, in Vercel: AUTH_URL=https://bzzy.ca. Leave unset locally and for
# previews, which use their own host.
# AUTH_URL=

# Firmware updates (docs/ota.md). Only needed if FIRMWARE_REPO is private: a
# fine-grained token with Contents: Read on that repo.
# FIRMWARE_GITHUB_TOKEN=
# FIRMWARE_REPO=vancityactivist/bzzy
