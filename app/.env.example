# Postgres (Neon). Vercel fills this in when you add Neon from the Marketplace.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: https://<your-app>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Firmware updates (docs/ota.md). A fine-grained token with Contents: Read on the
# repo, so the app can read its (private) releases.
FIRMWARE_GITHUB_TOKEN=
# FIRMWARE_REPO=vancityactivist/bzzy
