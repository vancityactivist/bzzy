(version 1)

# The Alps SKRT side-push switch's own land pattern puts its pads 0.1 mm from
# its plastic locating-peg holes. That's the manufacturer's layout, so allow it
# within the part.
(rule "SW1 own pegs"
  (constraint hole_clearance (min 0.05mm))
  (condition "A.Parent == 'SW1' && B.Parent == 'SW1'"))
